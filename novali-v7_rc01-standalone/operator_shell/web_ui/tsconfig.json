{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "$lib": ["src/lib"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js"]
}
